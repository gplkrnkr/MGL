VITE_API_URL=http://localhost:8000
# Firebase web app config (Firebase console → Project settings → Your apps → Web app). Used for
# phone sign-in. Public values, not secrets. Required for production builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mgl-backend.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mgl-backend
VITE_FIREBASE_APP_ID=
# Optional: enables Sentry error monitoring when set (no-op otherwise).
VITE_SENTRY_DSN=
