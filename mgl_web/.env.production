# Production build settings for mygrandlabour.com (`npm run build` loads this file).
# Every value here ends up in the public JavaScript bundle; never put secrets in VITE_* variables.
# The website and API share one host: nginx proxies /api to the backend.
VITE_API_URL=https://mygrandlabour.com
# Firebase web app config for project mgl-backend (public by design; access is controlled by
# Firebase's authorized domains and the backend verifying the ID token).
VITE_FIREBASE_API_KEY=AIzaSyCO-j9cDOtx11n5OOEGNt5EapzPOi8VAKY
VITE_FIREBASE_AUTH_DOMAIN=mgl-backend.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mgl-backend
VITE_FIREBASE_APP_ID=1:567532912446:web:45b30821fc9724d10fb66f
